@model Instructor

@{
ViewData["Title"]= "Instructor Details";
}
<h1>
	Instructor Details
</h1>


  <div class="card-body">
	<h5 class="card-title">@Model.Name</h5>
	<p class="card-text">Image: @Model.Image</p>

	<p class="card-text">Address: @Model.Address</p>
	<p class="card-text">Salary: @Model.Salary</p>
	
	</div>
