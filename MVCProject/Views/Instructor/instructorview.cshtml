@model List<Instructor>
@{
	ViewData["Title"] = "Instructor View";
 }

<h1>Instructor List</h1>
<form asp-action="SearchName" method="get" class="form form-control">
	<input type="text" name="Name" placeholder="Search By Name" />
	<button type="submit" class="btn btn-info">
		Search
	</button>

</form>

<a href="/Instructor/Create" class="btn btn-primary">New</a>
<table class="table table-bordered table-hover">

	<tr>
		<th>No.</th> 
		<th>Name</th>
		<th>Image</th>
		<th>Department</th>
		<th>Address</th>
		<th>Salary</th>
		<th>Course</th>

	</tr>

	@foreach(var inst in Model)
	{
		
		<tr>
			<td>@inst.Id</td>
			<td>
				<a asp-action="Details" asp-route-id="@inst.Id">
					@inst.Name
				</a> 
			</td>
			@* <td> @inst.Image</td> *@
			@* <td><img src="data:image/*;base64,@Convert.ToBase64String(inst.Image)" width="100" /></td> *@
			<td>
			@if (!string.IsNullOrEmpty(inst.Image))
			{
					<img src="/Images/@inst.Image" width="100" class="img-thumbnail" />
			}
			else
			{
					<img src="/Images/default.Png" width="100" class="img-thumbnail" />
			}
			</td>
			<td> @inst.Department.Name</td>
			<td> @inst.Address</td>
			<td> @inst.Salary</td>
			<td> @inst.Course.Name</td>
			<td>
				<a href="/Instructor/Edit/@inst.Id" class="btn btn-primary">Edit</a>
			</td>
		    <td >
				<form asp-action="SaveDelete" method="post" style="display:inline">

					<input type="hidden" name="id" value="@inst.Id" />

					<button type="submit" class="btn btn-danger">
						Delete
					</button>

				</form>
				@*<a href="/Instructor/savedelete/@inst.Id" class="btn btn-danger">Delete</a>*@
			</td>
		</tr>
	}

</table>
