
@model InstructorwithDepartment_Course_View

@{
	ViewData["Title"] = "Add Instructor";
}

<h1> Create new Instructor</h1>
<form method="post" action="/Instructor/SaveCreate">
	<div>
	<label>Name</label>
	<input name="Name" id="Name" value="@Model?.Name" type="text" class="form form-control" />
	</div>
	<div>
		<label>Image</label>
		<input name="Image" id="Image" value="@Model?.Image" type="text" class="form form-control" />
	</div>
	<div>
		<label>Salary</label>
		<input name="Salary" id="Salary" value="@Model?.Salary" type="number" class="form form-control" />
	</div>
	<div>
		<label>Address</label>
		<input name="Address" id="Address" value="@Model?.Address" type="text" class="form form-control" />
	</div>
	<div>
		<label>Dept_Id</label>
		@*<input name="Dept-Id" id="Dept-Id" value="@Model?.Dept_Id" type="number" class="form form-control" />*@
		<select name ="Dept_Id" id="Dept_Id" class="form form-control">
			@foreach(var dept in Model.DeptList)
			{
				<option value="@dept.Id">@dept.Name</option>
			}
		</select>
	</div>
	<div>
		<label>Course_Id</label>
		<select name="Crs_Id" id="Crs_Id" class="form form-control">

			@foreach (var course in Model.CrsList)
			{
				<option value="@course.Id">@course.Name</option>
			}
		</select>
	@*	<input name="Crs-Id" id="Crs-Id" value="@Model?.Crs_Id" type="number" class="form form-control" />*@
	</div>
	
	<input type="submit" value="Create" class="btn btn-success" />
</form>
<a href="/Instructor/Index"> Back to List </a>