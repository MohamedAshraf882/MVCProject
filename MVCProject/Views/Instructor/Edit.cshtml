@model InstructorwithDepartment_Course_View
@{
	ViewData["Title"] = "Edit";
}
<h1>Update instructor</h1>
<form method="post" action="/Instructor/SaveEdit">
	<input type="hidden" name="Id" value="@Model.Id" />
	<div>
		<label>Name</label>
		<input name="Name" id="Name" value="@Model?.Name" type="text" class="form form-control" />
	</div>
	<div>
		<label>Image</label>
		<input name="Image" id="Image" value="@Model?.Image" type="text" class="form form-control" />
	</div>
	<div>
		<label>Salary</label>
		<input name="Salary" id="Salary" value="@Model?.Salary" type="number" class="form form-control" />
	</div>
	<div>
		<label>Address</label>
		<input name="Address" id="Address" value="@Model?.Address" type="text" class="form form-control" />
	</div>
	<div>
		<label>Department</label>
		<select name="Dept_Id" id="Dept_Id" class="form form-control">
			@foreach (var dept in Model.DeptList)
			{
				if (Model.Dept_Id == dept.Id)
	            {   		
					<option value="@dept.Id" selected>@dept.Name</option>
				}
				else
				{
					<option value="@dept.Id">@dept.Name</option>

				}
			}
		</select>
	</div>
	<div>
		<label>Courses</label>
		<select name="Crs_Id" id="Crs_Id" class="form form-control">
			@foreach (var Crs in Model.CrsList)
			{
				if (Model.Crs_Id == Crs.Id)
				{
					<option value="@Crs.Id" selected>@Crs.Name</option>
				}
				else
				{
					<option value="@Crs.Id">@Crs.Name</option>

				}
			}
		</select>
	</div>

	<input type="submit" value="Save" class="btn btn-success" />

</form>
<a href="/Instructor/Index">Back To List</a>