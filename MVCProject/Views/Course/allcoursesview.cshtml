@model List<Course>
@{
	ViewData["Title"] = "All Courses";
}
<h1>All Courses</h1>
<form asp-action="SearchByName" method="Get" class="form form-control">
	<input name="Name" type="text" placeholder="Search By Name" />
	<button type="submit" class="btn  btn-outline-info">Search</button>
</form>

<a asp-action="AddCourse" asp-controller="Course" class="btn btn-primary"> New Course</a>
<table class="table table-bordered table-hover">
	<tr>
		<th>No.</th>
		<th>Name</th>
		<th>Hourse</th>
		<th>Degree</th>
		<th>Min Degree</th>
		<th>Dept-Id</th>
		<th>Edit</th>
		<th>Delete</th>
	</tr>
		@foreach(var course in Model)
		{
			<tr>
				<td>@course.Id</td>
				<td>
				<a asp-action="GetCourseById" asp-route-id="@course.Id">
						@course.Name
					</a> 
				</td>
				<td> @course.Hours</td>
				<td> @course.Degree</td>
				<td> @course.MinDegree</td>
				<td> @course.Dept_Id</td>
				<td>
					<a href="/Course/Edit/@course.Id" class="btn btn-primary">Edit</a>
				</td>
			<td>
				<form asp-action="Delete" method="post" style="display:inline">

					<input type="hidden" name="id" value="@course.Id" />

					<button type="submit" class="btn btn-danger">
						Delete
					</button>
			    </form>
			</td>
			</tr>
	    } 

</table>