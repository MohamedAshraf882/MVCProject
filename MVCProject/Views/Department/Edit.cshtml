@model Department
@{
	ViewData["Title"] = "Edit";

}
<h1> Edit </h1>
<form method="post" action="/Department/SaveEdit/@Model.Id">
	<div>
		<label>Name</label>
		<input name="Name" id="Name" value="@Model.Name" type="text" class="form form-control" />
	</div>
	<div>
		<label>Manger</label>
		<input name="Manger" id="Manger" value="@Model.Manger" type="text" class="form form-control" />
	</div>
	<div>
		<div>
		<input type="submit" value="Save" class="btn btn-primary" />
		</div>
	</div>
</form>
