@model Department
@{
		ViewData["Title"] = "Add";

}

<h1> Add</h1>

<form method="post" action="/Department/SaveAdd">
	<div>
		<label>Name</label>
		<input name="Name" id="Name" value="@Model?.Name" type="text" class="form form-control"/>
	</div>
	<div>
		<label>Manger</label>
		<input name="Manger" id="Manger" value="@Model?.Manger" type="text" class="form-control"/>
	</div>
	<div>
	<input type="submit" value="Create" class="btn btn-primary"/>
	</div>
</form>
<a href="/Department/GetAll"> Back to List </a>