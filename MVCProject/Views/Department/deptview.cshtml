@model List<Department>
@{
	ViewData["Title"] = "Department View";
}
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}
<h1> Department List</h1>
<form asp-action="SearchByName" method="get">
	<input type="text" name="Name" placeholder="Search By Name" />
	<button type="submit" class="btn btn-info">
		Search
	</button>

</form>
<a href="/Department/Add" class="btn btn-success">New</a>
<table class="table table-bordered table-hover" >
	
	<tr>
		<th>No.</th> 
		<th>Name</th>
		<th>Manager</th>
		<th>Dept Edit</th>
	</tr>
	@foreach(var dept in Model)
	{
		
		<tr>
			<td>@dept.Id</td>
			<td>
				<a asp-action="Details" asp-route-id="@dept.Id">
					@dept.Name
			</a>
			</td>
			<td>@dept.Manger</td>
			<td>
				<a href="/Department/Edit/@dept.Id" class=" btn btn-success">Edit</a>
			</td>
			<td>
				<form asp-action="Delete" method="post" style="display:inline">

					<input type="hidden" name="id" value="@dept.Id" />

					<button type="submit" class="btn btn-danger">
						Delete
					</button>

				</form>
				
			</td>
		</tr>
	}

</table>