@model List<Department>
@{
	ViewData["Title"] = "Department List";
}
<h1> index</h1>
<a href="/Department/Add" class="btn btn-success">New</a>
<table class="table table-bordered table-hover" >
	
	<tr>
		<th>No.</th> 
		<th>Name</th>
		<th>Manager</th>
	</tr>
	@foreach(var dept in Model)
	{
		
		<tr>
			<td>@dept.Id</td>
			<td>
				<a asp-action="Details" asp-route-id="@dept.Id">
					@dept.Name
			</a>
			</td>
			<td>@dept.Manger</td>
			<td>
				<a href="/Department/Edit/@dept.Id">Edit</a>
			</td>
		</tr>
	}

</table>